{
  "services": {
    "console": {
      "port": 8080,
      "route_path": "/",
      "memory_mb": 384,
      "service_account": "console",
      "env": {
        "SPRING_PROFILES_ACTIVE": "keycloak"
      },
      "secret_env": {
        "KEYCLOAK_ISSUER_URI": {
          "secret": "keycloak-console",
          "key": "issuer-uri"
        },
        "KEYCLOAK_INTERNAL_URI": {
          "secret": "keycloak-console",
          "key": "internal-uri"
        },
        "KEYCLOAK_CLIENT_ID": {
          "secret": "keycloak-console",
          "key": "client-id"
        },
        "KEYCLOAK_CLIENT_SECRET": {
          "secret": "keycloak-console",
          "key": "client-secret"
        }
      }
    }
  }
}
