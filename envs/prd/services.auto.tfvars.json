{
  "services": {
    "api": {
      "port": 8080,
      "database": true,
      "secret_env": {
        "KEYCLOAK_ISSUER_URI": {
          "secret": "keycloak-api",
          "key": "issuer-uri"
        },
        "KEYCLOAK_JWK_SET_URI": {
          "secret": "keycloak-api",
          "key": "jwk-set-uri"
        },
        "KEYCLOAK_AUDIENCE": {
          "secret": "keycloak-api",
          "key": "audience"
        }
      }
    },
    "web": {
      "port": 3000,
      "route_path": "/",
      "memory_mb": 256,
      "secret_env": {
        "KEYCLOAK_ISSUER_URI": {
          "secret": "keycloak-web",
          "key": "issuer-uri"
        },
        "KEYCLOAK_INTERNAL_URI": {
          "secret": "keycloak-web",
          "key": "internal-uri"
        },
        "KEYCLOAK_CLIENT_ID": {
          "secret": "keycloak-web",
          "key": "client-id"
        },
        "KEYCLOAK_CLIENT_SECRET": {
          "secret": "keycloak-web",
          "key": "client-secret"
        }
      }
    }
  }
}
