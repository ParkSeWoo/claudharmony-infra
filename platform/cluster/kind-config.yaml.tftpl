# Terraform 이 생성 (platform/cluster). 직접 수정하지 마세요.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: ${cluster_name}
nodes:
  - role: control-plane
    image: ${node_image}
    labels:
      ingress-ready: "true"
    # Mac:80 → 노드:30080 (Envoy Gateway 의 NodePort)
    extraPortMappings:
      - containerPort: 30080
        hostPort: ${http_host_port}
        listenAddress: "0.0.0.0"
        protocol: TCP
%{ for i in range(workers) ~}
  - role: worker
    image: ${node_image}
%{ endfor ~}
